@article{fbarez2022pmic,
  bibtex_show = {true},
  title = {PMIC: Improving Multi-Agent Reinforcement Learning with Progressive Mutual Information Collaboration},
  author = {Li, Pengyi and Tang, Hongyao and Yang, Tianpei and Hao, Xiaotian and Sang, Tong and Zheng, Yan and Hao, Jianye and Taylor, Matthew E. and Tao, Wenyuan and Wang, Zhen and Barez, Fazl},
  abstract = {In cooperative multi-agent reinforcement learning (MARL), a commonly used approach is to share individual experiences among agents for better coordination. Agents can usually benefit from others' valuable experiences for more efficient learning. However, not all shared experiences are useful for other agents. How to enable agents to communicate valuable experiences with each other effectively remains a key challenge. In this paper, we propose a novel MARL approach, Progressive Mutual Information Collaboration (PMIC), to conduct efficient experience sharing by maximizing the mutual information between individual state-action pairs and the joint team reward among agents. In PMIC, we design an information-theoretic empowerment objective to enable each agent to evaluate state-action pairs for others. We collect and propagate the evaluations to obtain the team's overall comments for each state-action pair, guiding all agents for better policy learning. We further reveal that optimizing our objective achieves a trade-off between maximizing reward and preserving the action distribution, resulting in steady exploration during the learning process. Empirical results demonstrate the superior performance of our PMIC approach compared with the state-of-the-art methods in a variety of cooperative MARL tasks. We also show that PMIC significantly improves the performance of population-based multi-agent algorithms in the StarCraft II micromanagement tasks, where teams of agents need to coordinate with each other to defeat enemy teams.},
  year = {2022},
  conference = {ICML 2022},
  preview = {paper_19911_main.jpeg},
  arxiv = {2111.00273},
  abbr = {icml},
  selected = {false},
  topic = {Multi-agent RL}
}

@misc{barez2022iii,
  bibtex_show = {true},
  title = {System III: Learning with Domain Knowledge for Safety Constraints},
  author = {Barez, Fazl and Hasanbieg, Hosien and Abbate, Alesandro},
  abstract = {Reinforcement learning agents naturally learn from extensive exploration. Exploration is costly and can be unsafe in safety-critical domains. This paper proposes a novel framework for incorporating domain knowledge to help guide safe exploration and boost sample efficiency. Previous approaches impose constraints, such as regularisation parameters in neural networks, that rely on large sample sets and often are not suitable for safety-critical domains where agents should almost always avoid unsafe actions. We propose a new algorithm, System III, that incorporates domain knowledge in the form of safety constraints to ensure that the agent avoids unsafe states during training. Our approach combines a reinforcement learning agent with a safety system that monitors the agent's actions and intervenes when necessary to prevent unsafe actions. We evaluate our approach on several benchmark tasks and show that it significantly improves sample efficiency and safety compared to state-of-the-art methods.},
  year = {2022},
  conference = {ML Safety Workshop @ NeurIPS 2022},
  arxiv = {2301.12561},
  abbr = {neurips},
  selected = {false},
  preview = {paper_19911_main.jpeg},
  topic = {AI Safety}
}

@misc{wang2021ed2,
  bibtex_show = {true},
  title = {Discovering topics and trends in the UK Government web archive},
  author = {Beavan, David and Barez, Fazl and Bel, M and Fitzgerald, John and
            Goudarouli, Eirini and Kollnig, Konrad and McGillivray, Barbara},
  abstract = {The challenge we address in this report is to make steps towards
              improving search and discovery of resources within this vast
              archive for future archive users, and how the UKGWA collection
              could begin to be unlocked for research and experimentation by
              approaching it as data (i.e. as a dataset at scale). The UKGWA has
              begun to examine independently the usefulness of modelling the
              hyperlinked structure of its collection for advanced corpus
              exploration; the aim of this collaboration is to test algorithms
              capable of searching for documents via the topics that they cover,
              envisioning a future convergence of these two research frameworks.
              This is a diachronic corpus that is ideal for studying the
              emergence of topics and how they feature through government
              websites over time, and it will indicate engagement priorities and
              how these change over time.},
  year = {2021},
